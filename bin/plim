#!/usr/bin/env bash

# Plim - Productivity CLI for developers (macOS, Linux, Windows Git Bash / WSL)

# ---------------------------------------------------------------------------
# Configurações (~/.config/plim/config ou ~/.plimrc)
# ---------------------------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/plim"
CONFIG_FILE="$CONFIG_DIR/config"
[[ -f "$HOME/.plimrc" ]] && CONFIG_FILE="$HOME/.plimrc"

_ENV_LANG="${PLIM_LANG:-}"
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"
[[ -n "$_ENV_LANG" ]] && PLIM_LANG="$_ENV_LANG"

# Resolve display language (pt if pt_* or set to pt, otherwise en)
if [[ -z "$PLIM_LANG" ]]; then
    if [[ "${LANG:-}" == pt* || "${LC_ALL:-}" == pt* ]]; then
        PLIM_LANG="pt"
    else
        PLIM_LANG="en"
    fi
fi

PLIM_VERSION="1.6.0"
GITHUB_REPO="marcusedu/plim"
RAW_BASE_URL="https://raw.githubusercontent.com/${GITHUB_REPO}/main"

SOUNDS_DIR="/System/Library/Sounds"
DEFAULT_API_URL="https://plim-api.marcusedu.workers.dev"
API_URL="${PLIM_API_URL:-$DEFAULT_API_URL}"

# Configurações do Modo Auto-Plim (Shell Hook)
DEFAULT_AUTO_THRESHOLD=30
DEFAULT_AUTO_IGNORE="vim,nvim,nano,emacs,less,more,man,top,htop,btop,ssh,tmux,screen,tail,watch,python,python3,node,irb,ghci,iex,mysql,psql,sqlite3,mongo,mongosh,bash,zsh,fish,sh"

# ---------------------------------------------------------------------------
# Efeitos Sonoros Multiplataforma
# ---------------------------------------------------------------------------
random_mac_sound() {
    if [[ -d "$SOUNDS_DIR" ]]; then
        local sounds=("$SOUNDS_DIR"/*.aiff)
        local count=${#sounds[@]}
        if [[ $count -gt 0 ]]; then
            local idx=$((RANDOM % count))
            local chosen=""
            local i=0
            for s in "${sounds[@]}"; do
                if [[ $i -eq $idx ]]; then
                    chosen="$s"
                    break
                fi
                i=$((i + 1))
            done
            echo "${chosen:-${sounds[0]}}"
            return
        fi
    fi
    echo ""
}

play_sound() {
    local sound_type="${1:-random}" # success | error | random | <nome_som>

    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS: afplay nativo
        local sound_file=""
        case "$sound_type" in
            success) sound_file="$SOUNDS_DIR/Ping.aiff" ;;
            error)   sound_file="$SOUNDS_DIR/Basso.aiff" ;;
            random)  sound_file=$(random_mac_sound) ;;
            *)
                if [[ -f "$SOUNDS_DIR/${sound_type}.aiff" ]]; then
                    sound_file="$SOUNDS_DIR/${sound_type}.aiff"
                else
                    sound_file=$(random_mac_sound)
                fi
                ;;
        esac
        if [[ -n "$sound_file" && -f "$sound_file" ]]; then
            afplay "$sound_file" </dev/null >/dev/null 2>&1 &
        fi

    elif [[ "$OSTYPE" == "linux"* ]]; then
        # Linux: PulseAudio / PipeWire / ALSA / Freedesktop Sound Theme
        local linux_sound=""
        if [[ "$sound_type" == "error" ]]; then
            linux_sound="/usr/share/sounds/freedesktop/stereo/dialog-error.oga"
        else
            linux_sound="/usr/share/sounds/freedesktop/stereo/complete.oga"
        fi

        if command -v paplay >/dev/null 2>&1 && [[ -f "$linux_sound" ]]; then
            paplay "$linux_sound" </dev/null >/dev/null 2>&1 &
        elif command -v canberra-gtk-play >/dev/null 2>&1; then
            canberra-gtk-play -i "${sound_type:-complete}" </dev/null >/dev/null 2>&1 &
        elif command -v pw-play >/dev/null 2>&1 && [[ -f "$linux_sound" ]]; then
            pw-play "$linux_sound" </dev/null >/dev/null 2>&1 &
        elif command -v aplay >/dev/null 2>&1 && [[ -f "$linux_sound" ]]; then
            aplay -q "$linux_sound" </dev/null >/dev/null 2>&1 &
        else
            printf '\a' # Terminal Bell clássico
        fi

    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        # Windows Git Bash / MSYS2: Som de sistema via PowerShell
        powershell.exe -NoProfile -Command "[System.Media.SystemSounds]::Asterisk.Play()" </dev/null >/dev/null 2>&1 &
    else
        printf '\a' # Fallback universal
    fi
}

# ---------------------------------------------------------------------------
# Notificações Locais de Desktop
# ---------------------------------------------------------------------------
show_desktop_notification() {
    local title="$1"
    local message="$2"

    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS: AppleScript nativo
        local nl=$'\n'
        osascript -e "display notification \"${message}\" with title \"${title}\"" </dev/null >/dev/null 2>&1 &

    elif [[ "$OSTYPE" == "linux"* ]]; then
        # Linux: libnotify / notify-send (GNOME, KDE, XFCE, etc.)
        if command -v notify-send >/dev/null 2>&1; then
            notify-send "$title" "$message" 2>/dev/null &
        fi

    elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" ]]; then
        # Windows Git Bash: Notificação nativa via PowerShell
        powershell.exe -NoProfile -Command "
          [Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] > \$null;
          \$template = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02);
          \$text = \$template.GetElementsByTagName('text');
          \$text.Item(0).AppendChild(\$template.CreateTextNode('$title')) > \$null;
          \$text.Item(1).AppendChild(\$template.CreateTextNode('$message')) > \$null;
          \$toast = [Windows.UI.Notifications.ToastNotification]::new(\$template);
          [Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier('Plim').Show(\$toast);
        " 2>/dev/null &

    elif grep -qi microsoft /proc/version 2>/dev/null; then
        # WSL: Tenta wsl-notify-send ou powershell
        if command -v wsl-notify-send.exe >/dev/null 2>&1; then
            wsl-notify-send.exe "$title" "$message" 2>/dev/null &
        elif command -v powershell.exe >/dev/null 2>&1; then
            powershell.exe -NoProfile -Command "[System.Media.SystemSounds]::Asterisk.Play()" 2>/dev/null &
        fi
    fi
}

# ---------------------------------------------------------------------------
# Funções Auxiliares (JSON & Duração)
# ---------------------------------------------------------------------------
escape_json() {
    if command -v python3 >/dev/null 2>&1; then
        python3 -c 'import json, sys; print(json.dumps(sys.stdin.read().rstrip("\n"))[1:-1], end="")' <<< "$1"
    else
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/}"
        s="${s//$'\t'/\\t}"
        printf "%s" "$s"
    fi
}

format_duration() {
    local elapsed=$1
    if [[ $elapsed -ge 3600 ]]; then
        echo "$((elapsed / 3600))h $(((elapsed % 3600) / 60))m $((elapsed % 60))s"
    elif [[ $elapsed -ge 60 ]]; then
        echo "$((elapsed / 60))m $((elapsed % 60))s"
    else
        echo "${elapsed}s"
    fi
}

send_telegram_direct() {
    local title="$1"
    local body="$2"
    local extra="$3"

    if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
        return 0
    fi

    local nl=$'\n'
    local text="<b>${title}</b>"
    if [[ -n "$body" ]]; then
        text="${text}${nl}${body}"
    fi

    if [[ -n "$extra" ]]; then
        local escaped_extra=$(echo "$extra" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
        if [[ ${#escaped_extra} -gt 3500 ]]; then
            escaped_extra="${escaped_extra: -3500}"
        fi
        text="${text}${nl}${nl}<pre>${escaped_extra}</pre>"
    fi

    if [[ "$SYNC_NOTIFY" == "true" ]]; then
        curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            -d chat_id="${TELEGRAM_CHAT_ID}" \
            --data-urlencode "text=${text}" \
            -d parse_mode="HTML" </dev/null >/dev/null 2>&1
    else
        nohup curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
            -d chat_id="${TELEGRAM_CHAT_ID}" \
            --data-urlencode "text=${text}" \
            -d parse_mode="HTML" </dev/null >/dev/null 2>&1 &
    fi
}

send_remote_notification() {
    local title="$1"
    local body="$2"
    local extra="$3"
    local duration="$4"
    local notif_status="$5"

    # Trunca extra com segurança para não sobrecarregar curl nem exceder limites
    if [[ -n "$extra" && ${#extra} -gt 3500 ]]; then
        extra="${extra: -3500}"
    fi

    # Modo 1: Plim Cloud / Cloudflare Worker (via token plim_live_...)
    if [[ -n "$PLIM_API_KEY" ]]; then
        local safe_title=$(escape_json "$title")
        local safe_body=$(escape_json "$body")
        local safe_extra=$(escape_json "$extra")
        local safe_dur=$(escape_json "$duration")

        local payload="{\"title\":\"${safe_title}\",\"body\":\"${safe_body}\",\"log\":\"${safe_extra}\",\"duration\":\"${safe_dur}\",\"status\":\"${notif_status:-info}\"}"

        if [[ "$SYNC_NOTIFY" == "true" ]]; then
            curl -s -X POST "${API_URL}/api/notify" \
                -H "Authorization: Bearer ${PLIM_API_KEY}" \
                -H "Content-Type: application/json" \
                -d "${payload}" </dev/null >/dev/null 2>&1
        else
            nohup curl -s -X POST "${API_URL}/api/notify" \
                -H "Authorization: Bearer ${PLIM_API_KEY}" \
                -H "Content-Type: application/json" \
                -d "${payload}" </dev/null >/dev/null 2>&1 &
        fi
        return 0
    fi

    # Modo 2: Self-hosted / Bot Telegram próprio direto
    if [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
        send_telegram_direct "$title" "$body" "$extra"
    fi
}

# ---------------------------------------------------------------------------
# Formatação de Comandos Encadeados (Auto-Plim & Executor)
# ---------------------------------------------------------------------------
format_chained_cmd() {
    local raw="$1"
    local lang="${2:-$PLIM_LANG}"
    local clean="$raw"

    # Remove plim run inicial se houver para destacar a linha real executada
    clean=$(echo "$clean" | sed -E "s/^[[:space:]]*plim[[:space:]]+run[[:space:]]+//")

    case "$clean" in
        *";"*|*"&&"*|*"||"*)
            local marked
            marked=$(echo "$clean" | sed -E "s/[[:space:]]*(&&|\|\||;)[[:space:]]*/@PLIM_SEP@/g")

            local count=0
            local out=""
            local IFS_BAK="$IFS"
            IFS='@'
            set -f
            for item in $marked; do
                if [[ "$item" == "PLIM_SEP" || -z "$item" ]]; then
                    continue
                fi
                item=$(echo "$item" | sed -E "s/^[[:space:]]+|[[:space:]]+$//g")
                [[ -z "$item" ]] && continue
                count=$((count + 1))
                if [[ $count -le 4 ]]; then
                    if [[ -n "$out" ]]; then
                        out="$out ➔ $item"
                    else
                        out="$item"
                    fi
                fi
            done
            set +f
            IFS="$IFS_BAK"

            if [[ $count -gt 1 ]]; then
                if [[ $count -gt 4 ]]; then
                    local rem=$((count - 4))
                    out="$out ... (+$rem)"
                fi
                if [[ "$lang" == "pt" ]]; then
                    echo "⛓️ ($count comandos) $out"
                else
                    echo "⛓️ ($count commands) $out"
                fi
            else
                echo "$clean"
            fi
            ;;
        *)
            echo "$clean"
            ;;
    esac
}

is_pure_plim_cmd() {
    local cmd="$1"
    cmd=$(echo "$cmd" | sed -E "s/^[[:space:]]+//")
    case "$cmd" in
        plim\ *|./bin/plim\ *|plim-mcp\ *|*/plim\ *)
            # Se contiver ;, && ou ||, e comando encadeado - nao e puro!
            case "$cmd" in
                *";"*|*"&&"*|*"||"*)
                    return 1
                    ;;
                *)
                    return 0
                    ;;
            esac
            ;;
        *)
            return 1
            ;;
    esac
}

is_ignored_cmd() {
    local cmd="$1"
    local ignore_list="${PLIM_AUTO_IGNORE:-$DEFAULT_AUTO_IGNORE}"
    cmd=$(echo "$cmd" | sed -E "s/^[[:space:]]+//")
    [[ -z "$cmd" ]] && return 0

    local first_word="${cmd%% *}"
    first_word=$(basename "$first_word" 2>/dev/null || echo "$first_word")

    local last_part="$cmd"
    case "$cmd" in
        *";"*|*"&&"*|*"||"*)
            last_part=$(echo "$cmd" | sed -E "s/.*(&&|\|\||;)[[:space:]]*//")
            ;;
    esac
    local last_word="${last_part%% *}"
    last_word=$(basename "$last_word" 2>/dev/null || echo "$last_word")

    if [[ ",$ignore_list," == *",$first_word,"* ]] || [[ ",$ignore_list," == *",$last_word,"* ]]; then
        return 0
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Modo Mensagens de Progresso Dinâmico (Live Status / Edit In-Place)
# ---------------------------------------------------------------------------
progress_api_call() {
    local endpoint="$1"
    local json_body="$2"

    if [[ -z "$PLIM_API_KEY" ]]; then
        return 1
    fi

    local res
    res=$(curl -s -X POST "${API_URL}/api/progress/${endpoint}" \
        -H "Authorization: Bearer ${PLIM_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "$json_body" 2>/dev/null)
    echo "$res"
}

progress_start() {
    local title="$1"
    shift 2>/dev/null || true
    local steps=("$@")

    local steps_json="[]"
    if [[ ${#steps[@]} -gt 0 ]]; then
        local items=""
        for s in "${steps[@]}"; do
            local esc_s=$(escape_json "$s")
            if [[ -n "$items" ]]; then
                items="$items, \"$esc_s\""
            else
                items="\"$esc_s\""
            fi
        done
        steps_json="[$items]"
    fi

    local esc_title=$(escape_json "$title")
    local body="{\"title\": \"$esc_title\", \"steps\": $steps_json}"
    local res
    res=$(progress_api_call "start" "$body")

    local prog_id
    prog_id=$(echo "$res" | sed -E 's/.*"id"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/' 2>/dev/null)
    if [[ -n "$prog_id" && "$prog_id" != "$res" ]]; then
        echo "$prog_id"
        return 0
    else
        return 1
    fi
}

progress_update() {
    local prog_id="$1"
    shift 2>/dev/null || true
    local percent=""
    local step=""
    local total_steps=""
    local text=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --percent|-p) percent="$2"; shift 2 ;;
            --step|-s) step="$2"; shift 2 ;;
            --total|-t) total_steps="$2"; shift 2 ;;
            --text|-m) text="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local body="{\"id\": \"$prog_id\""
    [[ -n "$percent" ]] && body="$body, \"percent\": $percent"
    [[ -n "$step" ]] && body="$body, \"step\": $step"
    [[ -n "$total_steps" ]] && body="$body, \"totalSteps\": $total_steps"
    if [[ -n "$text" ]]; then
        local esc_text=$(escape_json "$text")
        body="$body, \"text\": \"$esc_text\""
    fi
    body="$body}"

    progress_api_call "update" "$body" >/dev/null 2>&1 || true
}

progress_finish() {
    local prog_id="$1"
    shift 2>/dev/null || true
    local status="success"
    local text=""
    local duration=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status|-s) status="$2"; shift 2 ;;
            --text|-m) text="$2"; shift 2 ;;
            --duration|-d) duration="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local body="{\"id\": \"$prog_id\", \"status\": \"$status\""
    if [[ -n "$text" ]]; then
        local esc_text=$(escape_json "$text")
        body="$body, \"text\": \"$esc_text\""
    fi
    if [[ -n "$duration" ]]; then
        local esc_dur=$(escape_json "$duration")
        body="$body, \"duration\": \"$esc_dur\""
    fi
    body="$body}"

    progress_api_call "finish" "$body" >/dev/null 2>&1 || true

    if [[ "$status" == "error" ]]; then
        play_sound "error"
    else
        play_sound "success"
    fi
}

run_chained_with_progress() {
    local raw_cmd="$1"
    local clean="$raw_cmd"
    clean=$(echo "$clean" | sed -E "s/^[[:space:]]*plim[[:space:]]+run[[:space:]]+//")

    local marked
    marked=$(echo "$clean" | sed -E "s/[[:space:]]*(&&|\|\||;)[[:space:]]*/@PLIM_SEP@/g")

    local steps=()
    local IFS_BAK="$IFS"
    IFS='@'
    set -f
    for item in $marked; do
        if [[ "$item" == "PLIM_SEP" || -z "$item" ]]; then continue; fi
        item=$(echo "$item" | sed -E "s/^[[:space:]]+|[[:space:]]+$//g")
        [[ -z "$item" ]] && continue
        steps+=("$item")
    done
    set +f
    IFS="$IFS_BAK"

    local total=${#steps[@]}
    if [[ $total -le 1 ]]; then
        eval "$clean"
        return $?
    fi

    local start_time=$(date +%s)
    local title=$([[ "$PLIM_LANG" == "pt" ]] && echo "Execução Encadeada ($total passos)" || echo "Chained Execution ($total steps)")
    
    local prog_id=""
    if [[ -n "$PLIM_API_KEY" ]]; then
        prog_id=$(progress_start "$title" "${steps[@]}" 2>/dev/null || true)
    fi

    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "🚀 [plim progress] Iniciando execução encadeada ($total passos)..."
    else
        echo "🚀 [plim progress] Starting chained execution ($total steps)..."
    fi

    local exit_code=0
    local step_idx=0
    for ((i=0; i<total; i++)); do
        step_idx=$((i + 1))
        local current_cmd="${steps[$i]}"
        local pct=$(( (i * 100) / total ))

        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "⏳ [Passo $step_idx/$total] Executando: $current_cmd"
        else
            echo "⏳ [Step $step_idx/$total] Running: $current_cmd"
        fi

        if [[ -n "$prog_id" ]]; then
            local step_msg=$([[ "$PLIM_LANG" == "pt" ]] && echo "Executando passo $step_idx de $total: $current_cmd" || echo "Running step $step_idx of $total: $current_cmd")
            progress_update "$prog_id" --step "$step_idx" --total "$total" --percent "$pct" --text "$step_msg"
        fi

        eval "$current_cmd"
        exit_code=$?

        if [[ $exit_code -ne 0 ]]; then
            local end_time=$(date +%s)
            local duration=$(format_duration $((end_time - start_time)))
            local fail_msg=$([[ "$PLIM_LANG" == "pt" ]] && echo "Falhou no passo $step_idx/$total (exit $exit_code): $current_cmd" || echo "Failed at step $step_idx/$total (exit $exit_code): $current_cmd")

            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "❌ [plim progress] $fail_msg"
            else
                echo "❌ [plim progress] $fail_msg"
            fi

            if [[ -n "$prog_id" ]]; then
                progress_finish "$prog_id" --status error --text "$fail_msg" --duration "$duration"
            else
                play_sound "error"
            fi

            show_desktop_notification "❌ Plim: $fail_msg" "Duração: $duration"
            return $exit_code
        fi
    done

    local end_time=$(date +%s)
    local duration=$(format_duration $((end_time - start_time)))
    local success_msg=$([[ "$PLIM_LANG" == "pt" ]] && echo "Todos os $total passos concluídos com sucesso! 🎉" || echo "All $total steps completed successfully! 🎉")

    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "✅ [plim progress] $success_msg (Duração: $duration)"
    else
        echo "✅ [plim progress] $success_msg (Duration: $duration)"
    fi

    if [[ -n "$prog_id" ]]; then
        progress_finish "$prog_id" --status success --text "$success_msg" --duration "$duration"
    else
        play_sound "success"
    fi

    show_desktop_notification "✅ Plim: $success_msg" "Duração: $duration"
    return 0
}

manage_progress() {
    local action="${1:-}"
    shift 2>/dev/null || true

    case "$action" in
        start)
            local title="$1"
            shift 2>/dev/null || true
            progress_start "$title" "$@"
            ;;
        update)
            local prog_id="$1"
            shift 2>/dev/null || true
            progress_update "$prog_id" "$@"
            ;;
        finish)
            local prog_id="$1"
            shift 2>/dev/null || true
            progress_finish "$prog_id" "$@"
            ;;
        run)
            run_chained_with_progress "$*"
            ;;
        *)
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "Uso do comando plim progress:"
                echo "  plim progress run '<cmd1>; <cmd2>; ...'       # Executa comandos encadeados com Live Status no Telegram"
                echo "  plim progress start 'Título' [passos...]      # Inicia uma mensagem de progresso editável"
                echo "  plim progress update <id> --percent N --text 'msg' # Atualiza mensagem no Telegram"
                echo "  plim progress finish <id> --status success|error    # Conclui a mensagem com status final"
            else
                echo "Usage of plim progress command:"
                echo "  plim progress run '<cmd1>; <cmd2>; ...'       # Execute chained commands with Live Status on Telegram"
                echo "  plim progress start 'Title' [steps...]        # Start an editable live progress message"
                echo "  plim progress update <id> --percent N --text 'msg' # Update Telegram message in-place"
                echo "  plim progress finish <id> --status success|error    # Finalize message with completion status"
            fi
            return 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Modo Executor (plim run <comando>)
# ---------------------------------------------------------------------------
run_command() {
    if [[ $# -eq 0 ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "Uso: plim run <comando e argumentos>"
            echo "Exemplo: plim run npm run build"
            echo "Opções:"
            echo "  --progress, -P    Executa com Live Status dinâmico no Telegram"
        else
            echo "Usage: plim run <command and arguments>"
            echo "Example: plim run npm run build"
            echo "Options:"
            echo "  --progress, -P    Run with dynamic Live Status updates on Telegram"
        fi
        return 1
    fi

    # Se a flag --progress ou -P for passada, executa com progresso vivo
    if [[ "$1" == "--progress" || "$1" == "-P" ]]; then
        shift
        run_chained_with_progress "$*"
        return $?
    fi

    local full_cmd="$*"
    local formatted_cmd=$(format_chained_cmd "$full_cmd" "$PLIM_LANG")
    local start_time=$(date +%s)
    local temp_out=$(mktemp -t plim_output.XXXXXX 2>/dev/null || mktemp)

    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "🚀 [plim] Executando: $formatted_cmd"
    else
        echo "🚀 [plim] Running: $formatted_cmd"
    fi

    # Executa o comando via eval para suportar flags, pipes e encadeamentos
    eval "$@" 2>&1 | tee "$temp_out"
    local exit_code=${pipestatus[1]:-${PIPESTATUS[0]:-$?}}

    local end_time=$(date +%s)
    local duration=$(format_duration $((end_time - start_time)))

    local tail_output=$(tail -n 15 "$temp_out" 2>/dev/null)
    rm -f "$temp_out"

    local status_icon status_label status_type sound_key
    if [[ $exit_code -eq 0 ]]; then
        status_icon="✅"
        status_label=$([[ "$PLIM_LANG" == "pt" ]] && echo "Sucesso" || echo "Success")
        status_type="success"
        sound_key="success"
    else
        status_icon="❌"
        status_label=$([[ "$PLIM_LANG" == "pt" ]] && echo "Falha (exit $exit_code)" || echo "Failed (exit $exit_code)")
        status_type="error"
        sound_key="error"
    fi

    # 1. Som nativo
    play_sound "$sound_key"

    # 2. Notificação local de desktop
    local nl=$'\n'
    local dur_prefix=$([[ "$PLIM_LANG" == "pt" ]] && echo "Duração" || echo "Duration")
    show_desktop_notification "${status_icon} Plim: ${status_label}" "${dur_prefix}: ${duration}${nl}${formatted_cmd}"

    # 3. Notificação Remota (Cloudflare Worker ou Telegram Direto)
    send_remote_notification "${status_icon} ${status_label}: ${formatted_cmd}" "" "$tail_output" "$duration" "$status_type"

    return $exit_code
}

start_mcp_server() {
    local source="${BASH_SOURCE[0]:-$0}"
    while [[ -h "$source" ]]; do
        local dir="$(cd -P "$(dirname "$source")" && pwd)"
        source="$(readlink "$source")"
        [[ $source != /* ]] && source="$dir/$source"
    done
    local script_dir="$(cd -P "$(dirname "$source")" && pwd)"

    if command -v node >/dev/null 2>&1; then
        exec node "$script_dir/plim-mcp.js" "$@"
    else
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "Erro: Node.js é necessário para executar o servidor MCP do Plim."
        else
            echo "Error: Node.js is required to run the Plim MCP server."
        fi
        return 1
    fi
}

# ---------------------------------------------------------------------------
# Modo Pergunta Interativa (plim ask <pergunta> [opções...])
# ---------------------------------------------------------------------------
ask_cli() {
    local question="$1"
    shift 2>/dev/null || true

    if [[ -z "$question" || "$question" == "-h" || "$question" == "--help" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "Uso: plim ask \"Sua pergunta\" [opcao1] [opcao2] ..."
            echo "Exemplo: plim ask \"Aplicar migração em produção?\" \"Sim\" \"Não\""
        else
            echo "Usage: plim ask \"Your question\" [option1] [option2] ..."
            echo "Example: plim ask \"Deploy migration to production?\" \"Yes\" \"No\""
        fi
        return 1
    fi

    if [[ -z "$PLIM_API_KEY" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "❌ Erro: Plim não está conectado ao Telegram. Execute 'plim connect <token>' primeiro."
        else
            echo "❌ Error: Plim is not connected to Telegram. Run 'plim connect <token>' first."
        fi
        return 1
    fi

    # Constrói array de opções JSON (limpa vírgulas ou colchetes extras se digitados)
    local default_opts=$([[ "$PLIM_LANG" == "pt" ]] && echo '["Sim", "Não"]' || echo '["Yes", "No"]')
    local options_json="$default_opts"
    if [[ $# -gt 0 ]]; then
        local opts=()
        for opt in "$@"; do
            local cleaned="${opt#,}"
            cleaned="${cleaned%,}"
            cleaned="${cleaned#[}"
            cleaned="${cleaned%]}"
            cleaned=$(echo "$cleaned" | tr -d '[]' | xargs 2>/dev/null || echo "$cleaned")
            [[ -z "$cleaned" ]] && continue
            opts+=("\"$(escape_json "$cleaned")\"")
        done
        if [[ ${#opts[@]} -gt 0 ]]; then
            local joined=$(IFS=,; echo "${opts[*]}")
            options_json="[${joined}]"
        fi
    fi

    local safe_q=$(escape_json "$question")
    local payload="{\"question\":\"${safe_q}\",\"options\":${options_json},\"type\":\"question\"}"

    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "📱 Enviando pergunta para o seu Telegram..."
    else
        echo "📱 Sending question to your Telegram..."
    fi

    local res
    res=$(curl -s -X POST "${API_URL}/api/ask" \
        -H "Authorization: Bearer ${PLIM_API_KEY}" \
        -H "Content-Type: application/json" \
        -d "${payload}")

    local ask_id=""
    if command -v python3 >/dev/null 2>&1; then
        ask_id=$(python3 -c 'import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(d.get("id", ""))
except Exception:
    pass' <<< "$res")
    else
        ask_id=$(echo "$res" | sed -n 's/.*"id"[ ]*:[ ]*"\([^"]*\)".*/\1/p')
    fi

    if [[ -z "$ask_id" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "❌ Falha ao enviar pergunta: $res"
        else
            echo "❌ Failed to send question: $res"
        fi
        return 1
    fi

    play_sound "Ping"
    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "⏳ Pergunta enviada! Aguardando sua resposta no celular..."
    else
        echo "⏳ Question sent! Waiting for response on your mobile phone..."
    fi

    local start_ts=$(date +%s)
    local timeout_sec=300

    while true; do
        local now_ts=$(date +%s)
        if (( now_ts - start_ts > timeout_sec )); then
            echo ""
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "⏱️ Tempo limite de espera esgotado (${timeout_sec}s)."
            else
                echo "⏱️ Timeout waiting for response (${timeout_sec}s)."
            fi
            return 1
        fi

        sleep 2
        local status_res
        status_res=$(curl -s -X GET "${API_URL}/api/ask/${ask_id}" \
            -H "Authorization: Bearer ${PLIM_API_KEY}")

        local status_val=""
        local answer_val=""
        local answer_idx=0
        if command -v python3 >/dev/null 2>&1; then
            eval $(python3 -c 'import json, sys, shlex
try:
    d = json.loads(sys.stdin.read())
    s = d.get("status", "")
    a = d.get("answer", "")
    i = d.get("answerIndex", 0)
    print(f"status_val={shlex.quote(str(s))}; answer_val={shlex.quote(str(a))}; answer_idx={int(i)}")
except Exception:
    pass' <<< "$status_res")
        fi

        if [[ "$status_val" == "answered" ]]; then
            echo ""
            play_sound "success"
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "🎉 Resposta recebida pelo Telegram: ${answer_val}"
            else
                echo "🎉 Response received from Telegram: ${answer_val}"
            fi
            return "$answer_idx"
        fi
        printf "."
    done
}

# ---------------------------------------------------------------------------
# Verificação Diária Automática e Auto-Update
# ---------------------------------------------------------------------------
check_update_daily() {
    # Ignora checagem se estiver rodando comandos internos ou de ajuda
    case "$1" in
        update|--update|version|--version|-v|mcp) return 0 ;;
    esac

    local check_file="$CONFIG_DIR/.last_update_check"
    local latest_file="$CONFIG_DIR/.latest_version"
    local now
    now=$(date +%s 2>/dev/null || echo 0)
    local interval=86400 # 24 horas

    # 1. Se já sabemos que existe uma versão mais recente em cache, avisa com elegância
    if [[ -f "$latest_file" ]]; then
        local remote_ver
        remote_ver=$(cat "$latest_file" 2>/dev/null | tr -d '[:space:]')
        if [[ -n "$remote_ver" && "$remote_ver" != "$PLIM_VERSION" ]]; then
            if [[ "$PLIM_LANG" == "pt" ]]; then
                printf "\n💡 \033[1;33mNova versão do Plim disponível:\033[0m %s → \033[1;32m%s\033[0m\n" "$PLIM_VERSION" "$remote_ver"
                printf "   Execute \033[1;36mplim update\033[0m para atualizar.\n\n"
            else
                printf "\n💡 \033[1;33mNew Plim version available:\033[0m %s → \033[1;32m%s\033[0m\n" "$PLIM_VERSION" "$remote_ver"
                printf "   Run \033[1;36mplim update\033[0m to upgrade.\n\n"
            fi
        fi
    fi

    # 2. Verifica se passou 24h desde a última verificação
    local last_check=0
    [[ -f "$check_file" ]] && last_check=$(cat "$check_file" 2>/dev/null || echo 0)

    if (( now - last_check > interval )); then
        mkdir -p "$CONFIG_DIR" 2>/dev/null || true
        echo "$now" > "$check_file" 2>/dev/null || true

        # Checagem em background desvinculada (detached subshell)
        # Timeout rígido de 2s para NUNCA travar ou atrasar o comando do usuário
        (
            local r_ver
            r_ver=$(curl -fsSL --connect-timeout 2 --max-time 3 "${RAW_BASE_URL}/VERSION" 2>/dev/null | tr -d '[:space:]')
            if [[ -n "$r_ver" ]]; then
                echo "$r_ver" > "$latest_file"
            fi
        ) </dev/null >/dev/null 2>&1 &
    fi
}

update_plim() {
    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "🔍 Verificando atualizações no GitHub (${GITHUB_REPO})..."
    else
        echo "🔍 Checking for updates on GitHub (${GITHUB_REPO})..."
    fi
    local remote_ver
    remote_ver=$(curl -fsSL --connect-timeout 5 "${RAW_BASE_URL}/VERSION" 2>/dev/null | tr -d '[:space:]')

    if [[ -z "$remote_ver" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "❌ Não foi possível verificar a versão remota. Verifique sua conexão com a internet."
        else
            echo "❌ Could not check remote version. Check your internet connection."
        fi
        return 1
    fi

    if [[ "$remote_ver" == "$PLIM_VERSION" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "✅ O Plim já está na versão mais recente (v${PLIM_VERSION})!"
        else
            echo "✅ Plim is already on the latest version (v${PLIM_VERSION})!"
        fi
        rm -f "$CONFIG_DIR/.latest_version" 2>/dev/null || true
        return 0
    fi

    if [[ "$PLIM_LANG" == "pt" ]]; then
        echo "🚀 Atualizando Plim: v${PLIM_VERSION} → v${remote_ver}..."
    else
        echo "🚀 Updating Plim: v${PLIM_VERSION} → v${remote_ver}..."
    fi

    # Resolve o caminho real do executável
    local target="${BASH_SOURCE[0]:-$0}"
    while [[ -h "$target" ]]; do
        local dir="$(cd -P "$(dirname "$target")" && pwd)"
        target="$(readlink "$target")"
        [[ $target != /* ]] && target="$dir/$target"
    done
    local target_dir="$(cd -P "$(dirname "$target")" && pwd)"

    local temp_bin
    temp_bin=$(mktemp 2>/dev/null || mktemp -t plim_update.XXXXXX)

    if curl -fsSL "${RAW_BASE_URL}/bin/plim" -o "$temp_bin"; then
        chmod +x "$temp_bin"
        mv "$temp_bin" "$target_dir/plim"

        # Baixa também o script MCP se existir
        curl -fsSL "${RAW_BASE_URL}/bin/plim-mcp.js" -o "$target_dir/plim-mcp.js" 2>/dev/null || true
        chmod +x "$target_dir/plim-mcp.js" 2>/dev/null || true

        # Limpa o arquivo de versão pendente
        rm -f "$CONFIG_DIR/.latest_version" 2>/dev/null || true

        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "🎉 Plim atualizado com sucesso para a versão v${remote_ver}!"
        else
            echo "🎉 Plim updated successfully to version v${remote_ver}!"
        fi
        return 0
    else
        rm -f "$temp_bin"
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "❌ Falha ao baixar os arquivos da nova versão."
        else
            echo "❌ Failed to download new version files."
        fi
        return 1
    fi
}

# Executa checagem diária não-bloqueante
check_update_daily "$1"

# ---------------------------------------------------------------------------
# Entrada de Pipe ou Notificação Rápida
# ---------------------------------------------------------------------------
handle_notify_or_pipe() {
    local message="$*"
    local input_data=""

    # Se houver entrada vinda de pipe (ex: comando | plim ou comando | plim -n "Fim")
    if [[ ! -t 0 ]]; then
        local temp_pipe
        temp_pipe=$(mktemp -t plim_pipe.XXXXXX 2>/dev/null || mktemp)
        # tee repassa imediatamente para o stdout sem travar o streaming
        tee "$temp_pipe"
        input_data=$(tail -n 25 "$temp_pipe" 2>/dev/null)
        rm -f "$temp_pipe"
    fi

    play_sound "random"

    # Interpreta \n se passado na mensagem
    [[ -n "$message" ]] && message=$(printf "%b" "$message")

    local def_msg=$([[ "$PLIM_LANG" == "pt" ]] && echo "Processamento concluído" || echo "Processing completed")
    local notif_prefix=$([[ "$PLIM_LANG" == "pt" ]] && echo "Notificação" || echo "Notification")
    local pipe_prefix=$([[ "$PLIM_LANG" == "pt" ]] && echo "Pipe concluído" || echo "Pipe completed")

    local local_msg="${message:-$def_msg}"
    local notif_title="🔔 Plim: ${message:-$notif_prefix}"

    if [[ -z "$message" && -n "$input_data" ]]; then
        local_msg=$(echo "$input_data" | tail -n 2)
        notif_title="🔔 Plim: $pipe_prefix"
    fi

    show_desktop_notification "Plim" "$local_msg"
    send_remote_notification "$notif_title" "" "$input_data" "" "info"
}

manage_lang() {
    local new_lang="$1"
    if [[ -z "$new_lang" ]]; then
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "Idioma atual: Português (pt)"
            echo "Para alterar: plim lang en"
        else
            echo "Current language: English (en)"
            echo "To change: plim lang pt"
        fi
        return 0
    fi

    case "$new_lang" in
        pt|pt-BR|pt_BR|portugues|portuguese)
            new_lang="pt"
            ;;
        en|en-US|en_US|english|ingles)
            new_lang="en"
            ;;
        *)
            echo "Invalid language: $new_lang (supported: en, pt)"
            return 1
            ;;
    esac

    mkdir -p "$CONFIG_DIR" 2>/dev/null || true
    touch "$CONFIG_FILE" 2>/dev/null || true
    if grep -q '^PLIM_LANG=' "$CONFIG_FILE" 2>/dev/null; then
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/^PLIM_LANG=.*/PLIM_LANG=\"$new_lang\"/" "$CONFIG_FILE"
        else
            sed -i "s/^PLIM_LANG=.*/PLIM_LANG=\"$new_lang\"/" "$CONFIG_FILE"
        fi
    else
        echo "PLIM_LANG=\"$new_lang\"" >> "$CONFIG_FILE"
    fi

    if [[ "$new_lang" == "pt" ]]; then
        echo "✅ Idioma configurado para Português (pt)."
    else
        echo "✅ Language configured to English (en)."
    fi
}

# ---------------------------------------------------------------------------
# Modo Auto-Plim (Shell Hooks para Zsh, Bash e Fish)
# ---------------------------------------------------------------------------
generate_hook_script() {
    local target_shell="${1:-zsh}"

    case "$target_shell" in
        zsh)
            cat << 'EOF'
# ---------------------------------------------------------------------------
# Plim Shell Hook (Auto-Plim for Zsh)
# Monitoramento transparente de comandos demorados e encadeados
# ---------------------------------------------------------------------------
_plim_zsh_preexec() {
    if zmodload zsh/datetime 2>/dev/null; then
        _PLIM_CMD_START=$EPOCHSECONDS
    else
        _PLIM_CMD_START=$(date +%s)
    fi
    _PLIM_CMD_LINE="$1"
}

_plim_zsh_precmd() {
    local exit_code=$?
    if [[ -n "$_PLIM_CMD_START" ]]; then
        local now
        if zmodload zsh/datetime 2>/dev/null; then
            now=$EPOCHSECONDS
        else
            now=$(date +%s)
        fi
        local elapsed=$((now - _PLIM_CMD_START))
        local cmd="$_PLIM_CMD_LINE"
        _PLIM_CMD_START=""
        _PLIM_CMD_LINE=""

        local threshold="${PLIM_AUTO_THRESHOLD:-30}"
        if (( elapsed >= threshold )); then
            command plim hook notify "$exit_code" "$elapsed" "$cmd" </dev/null >/dev/null 2>&1 &
        fi
    fi
}

autoload -Uz add-zsh-hook 2>/dev/null || true
add-zsh-hook preexec _plim_zsh_preexec 2>/dev/null || true
add-zsh-hook precmd _plim_zsh_precmd 2>/dev/null || true
EOF
            ;;

        bash)
            cat << 'EOF'
# ---------------------------------------------------------------------------
# Plim Shell Hook (Auto-Plim for Bash)
# Monitoramento transparente de comandos demorados e encadeados
# ---------------------------------------------------------------------------
_plim_bash_preexec() {
    if [[ -z "$_PLIM_CMD_START" ]]; then
        _PLIM_CMD_START=$(date +%s)
        _PLIM_CMD_LINE=$(history 1 2>/dev/null | sed 's/^[ ]*[0-9]*[ ]*//')
        [[ -z "$_PLIM_CMD_LINE" ]] && _PLIM_CMD_LINE="$BASH_COMMAND"
    fi
}

_plim_bash_precmd() {
    local exit_code=$?
    if [[ -n "$_PLIM_CMD_START" ]]; then
        local now=$(date +%s)
        local elapsed=$((now - _PLIM_CMD_START))
        local cmd="$_PLIM_CMD_LINE"
        _PLIM_CMD_START=""
        _PLIM_CMD_LINE=""

        local threshold="${PLIM_AUTO_THRESHOLD:-30}"
        if [[ $elapsed -ge $threshold ]]; then
            command plim hook notify "$exit_code" "$elapsed" "$cmd" </dev/null >/dev/null 2>&1 &
        fi
    fi
}

trap '_plim_bash_preexec' DEBUG
if [[ -z "$PROMPT_COMMAND" ]]; then
    PROMPT_COMMAND="_plim_bash_precmd"
elif [[ "$PROMPT_COMMAND" != *"_plim_bash_precmd"* ]]; then
    PROMPT_COMMAND="_plim_bash_precmd; $PROMPT_COMMAND"
fi
EOF
            ;;

        fish)
            cat << 'EOF'
# ---------------------------------------------------------------------------
# Plim Shell Hook (Auto-Plim for Fish)
# Monitoramento transparente de comandos demorados e encadeados
# ---------------------------------------------------------------------------
function _plim_fish_preexec --on-event fish_preexec
    set -g _PLIM_CMD_START (date +%s)
    set -g _PLIM_CMD_LINE "$argv[1]"
end

function _plim_fish_postexec --on-event fish_postexec
    set -l exit_code $status
    if set -q _PLIM_CMD_START
        set -l now (date +%s)
        set -l elapsed (math $now - $_PLIM_CMD_START)
        set -l threshold (test -n "$PLIM_AUTO_THRESHOLD"; and echo "$PLIM_AUTO_THRESHOLD"; or echo "30")
        if test $elapsed -ge $threshold
            set -l cmd_line "$_PLIM_CMD_LINE"
            command plim hook notify "$exit_code" "$elapsed" "$cmd_line" </dev/null >/dev/null 2>&1 &
        end
        set -e _PLIM_CMD_START
        set -e _PLIM_CMD_LINE
    end
end
EOF
            ;;

        *)
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "Shell não suportado: $target_shell (suportados: zsh, bash, fish)" >&2
            else
                echo "Unsupported shell: $target_shell (supported: zsh, bash, fish)" >&2
            fi
            return 1
            ;;
    esac
}

hook_notify() {
    local exit_code="${1:-0}"
    local elapsed="${2:-0}"
    shift 2 2>/dev/null || true
    local raw_cmd="$*"

    local threshold="${PLIM_AUTO_THRESHOLD:-$DEFAULT_AUTO_THRESHOLD}"
    # Se durou menos que o limiar, nao faz nada
    if [[ "$elapsed" -lt "$threshold" ]]; then
        return 0
    fi

    # Se for comando interativo ignorado, nao faz nada
    if is_ignored_cmd "$raw_cmd"; then
        return 0
    fi

    # Se for invocacao pura do plim (sem encadeamentos), o plim ja gerenciou o alerta!
    if is_pure_plim_cmd "$raw_cmd"; then
        return 0
    fi

    local formatted_cmd=$(format_chained_cmd "$raw_cmd" "$PLIM_LANG")
    local duration=$(format_duration "$elapsed")

    local status_icon status_label status_type sound_key
    if [[ $exit_code -eq 0 ]]; then
        status_icon="✅"
        status_label=$([[ "$PLIM_LANG" == "pt" ]] && echo "Sucesso" || echo "Success")
        status_type="success"
        sound_key="success"
    else
        status_icon="❌"
        status_label=$([[ "$PLIM_LANG" == "pt" ]] && echo "Falha (exit $exit_code)" || echo "Failed (exit $exit_code)")
        status_type="error"
        sound_key="error"
    fi

    # 1. Som nativo local (se nao desativado explicitamente)
    if [[ "${PLIM_AUTO_SOUND:-true}" != "false" ]]; then
        play_sound "$sound_key"
    fi

    # 2. Notificacao local no Desktop
    if [[ "${PLIM_AUTO_DESKTOP:-true}" != "false" ]]; then
        local nl=$'\n'
        local dur_prefix=$([[ "$PLIM_LANG" == "pt" ]] && echo "Duração" || echo "Duration")
        show_desktop_notification "${status_icon} Plim: ${status_label}" "${dur_prefix}: ${duration}${nl}${formatted_cmd}"
    fi

    # 3. Notificacao remota (Telegram)
    if [[ "${PLIM_AUTO_TELEGRAM:-true}" != "false" ]]; then
        send_remote_notification "${status_icon} ${status_label}: ${formatted_cmd}" "" "" "$duration" "$status_type"
    fi
}

manage_hook() {
    local action="${1:-}"

    case "$action" in
        zsh|bash|fish)
            generate_hook_script "$action"
            ;;

        notify)
            shift
            hook_notify "$@"
            ;;

        install)
            shift
            local target_shell="${1:-}"
            if [[ -z "$target_shell" ]]; then
                if [[ "$SHELL" == *"zsh"* ]]; then target_shell="zsh"
                elif [[ "$SHELL" == *"bash"* ]]; then target_shell="bash"
                elif [[ "$SHELL" == *"fish"* ]]; then target_shell="fish"
                else target_shell="zsh"
                fi
            fi

            local rcfile=""
            case "$target_shell" in
                zsh)
                    rcfile="$HOME/.zshrc"
                    ;;
                bash)
                    if [[ "$OSTYPE" == "darwin"* && -f "$HOME/.bash_profile" ]]; then
                        rcfile="$HOME/.bash_profile"
                    else
                        rcfile="$HOME/.bashrc"
                    fi
                    ;;
                fish)
                    rcfile="$HOME/.config/fish/config.fish"
                    ;;
                *)
                    echo "Shell inválido: $target_shell (opções: zsh, bash, fish)"
                    return 1
                    ;;
            esac

            mkdir -p "$(dirname "$rcfile")" 2>/dev/null || true
            touch "$rcfile" 2>/dev/null || true

            if grep -q "plim hook" "$rcfile" 2>/dev/null; then
                if [[ "$PLIM_LANG" == "pt" ]]; then
                    echo "ℹ️  O hook do Auto-Plim já está instalado em: $rcfile"
                else
                    echo "ℹ️  Auto-Plim hook is already installed in: $rcfile"
                fi
                return 0
            fi

            if [[ "$target_shell" == "fish" ]]; then
                cat << 'EOF' >> "$rcfile"

# Plim Shell Hook (Auto-Plim)
plim hook fish | source
EOF
            else
                cat << EOF >> "$rcfile"

# Plim Shell Hook (Auto-Plim)
eval "\$(plim hook $target_shell)"
EOF
            fi

            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "🎉 Hook do Auto-Plim ($target_shell) instalado com sucesso em: $rcfile"
                echo "👉 Para ativar agora no terminal atual, rode:"
                echo "   source $rcfile"
            else
                echo "🎉 Auto-Plim hook ($target_shell) successfully installed in: $rcfile"
                echo "👉 To activate in your current terminal session, run:"
                echo "   source $rcfile"
            fi
            ;;

        uninstall)
            shift
            local rcfiles=("$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.config/fish/config.fish")
            local removed=0
            for f in "${rcfiles[@]}"; do
                if [[ -f "$f" ]] && grep -q "plim hook" "$f" 2>/dev/null; then
                    if [[ "$OSTYPE" == "darwin"* ]]; then
                        sed -i '' '/# Plim Shell Hook (Auto-Plim)/d' "$f" 2>/dev/null || true
                        sed -i '' '/plim hook/d' "$f" 2>/dev/null || true
                    else
                        sed -i '/# Plim Shell Hook (Auto-Plim)/d' "$f" 2>/dev/null || true
                        sed -i '/plim hook/d' "$f" 2>/dev/null || true
                    fi
                    removed=1
                    if [[ "$PLIM_LANG" == "pt" ]]; then
                        echo "✅ Hook removido de: $f"
                    else
                        echo "✅ Hook removed from: $f"
                    fi
                fi
            done

            if [[ $removed -eq 0 ]]; then
                if [[ "$PLIM_LANG" == "pt" ]]; then
                    echo "ℹ️  Nenhuma instalação do hook foi encontrada nos arquivos de configuração."
                else
                    echo "ℹ️  No hook installation found in shell configuration files."
                fi
            fi
            ;;

        status)
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "⚡ Status do Auto-Plim (Shell Hook):"
                echo "  Limiar de tempo: ${PLIM_AUTO_THRESHOLD:-$DEFAULT_AUTO_THRESHOLD} segundos"
                echo "  Notificação no Telegram: ${PLIM_AUTO_TELEGRAM:-true}"
                echo "  Som local: ${PLIM_AUTO_SOUND:-true}"
                echo "  Comandos ignorados: ${PLIM_AUTO_IGNORE:-$DEFAULT_AUTO_IGNORE}"
                echo ""
                echo "Instalações detectadas:"
                for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.config/fish/config.fish"; do
                    if [[ -f "$f" ]] && grep -q "plim hook" "$f" 2>/dev/null; then
                        echo "  ✅ Instalado em: $f"
                    fi
                done
                echo ""
                echo "Comandos disponíveis:"
                echo "  plim hook install   # Instala no shell atual"
                echo "  plim hook test      # Testa a notificação do Auto-Plim"
            else
                echo "⚡ Auto-Plim Status (Shell Hook):"
                echo "  Duration threshold: ${PLIM_AUTO_THRESHOLD:-$DEFAULT_AUTO_THRESHOLD} seconds"
                echo "  Telegram push: ${PLIM_AUTO_TELEGRAM:-true}"
                echo "  Local sound: ${PLIM_AUTO_SOUND:-true}"
                echo "  Ignored commands: ${PLIM_AUTO_IGNORE:-$DEFAULT_AUTO_IGNORE}"
                echo ""
                echo "Detected installations:"
                for f in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.config/fish/config.fish"; do
                    if [[ -f "$f" ]] && grep -q "plim hook" "$f" 2>/dev/null; then
                        echo "  ✅ Installed in: $f"
                    fi
                done
                echo ""
                echo "Available commands:"
                echo "  plim hook install   # Install hook in current shell"
                echo "  plim hook test      # Test Auto-Plim notification"
            fi
            ;;

        test)
            shift
            local test_cmd="${*:-plim run flutter clean;npm run build:all;sleep 15;firebase deploy -P production}"
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "🧪 Testando Auto-Plim com comando demorado simulado (88s):"
                echo "   Comando: $test_cmd"
            else
                echo "🧪 Testing Auto-Plim with simulated long-running command (88s):"
                echo "   Command: $test_cmd"
            fi
            hook_notify 0 88 "$test_cmd"
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "✅ Teste concluído! Verifique o som local e a notificação no Telegram."
            else
                echo "✅ Test completed! Check local sound and Telegram push notification."
            fi
            ;;

        *)
            local auto_sh="zsh"
            if [[ "$SHELL" == *"bash"* ]]; then auto_sh="bash"
            elif [[ "$SHELL" == *"fish"* ]]; then auto_sh="fish"
            fi
            generate_hook_script "$auto_sh"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Roteamento de Comandos CLI
# ---------------------------------------------------------------------------
case "$1" in
    run|--run)
        shift
        run_command "$@"
        ;;

    ask|--ask)
        shift
        ask_cli "$@"
        ;;

    update|--update)
        shift
        update_plim "$@"
        ;;

    version|--version|-v)
        echo "Plim v${PLIM_VERSION}"
        ;;

    mcp)
        shift
        start_mcp_server "$@"
        ;;

    lang|--lang)
        shift
        manage_lang "$@"
        ;;

    hook|--hook)
        shift
        manage_hook "$@"
        ;;

    progress|--progress)
        shift
        manage_progress "$@"
        ;;

    connect)
        shift
        token="$1"
        if [[ -z "$token" ]]; then
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "Uso: plim connect <SEU_TOKEN>"
                echo "Exemplo: plim connect plim_live_abc123..."
                echo ""
                echo "Para obter um token, abra o bot no Telegram e envie /start:"
                echo "👉 https://t.me/plim_the_bot"
            else
                echo "Usage: plim connect <YOUR_TOKEN>"
                echo "Example: plim connect plim_live_abc123..."
                echo ""
                echo "To get a token, open the bot on Telegram and send /start:"
                echo "👉 https://t.me/plim_the_bot"
            fi
            return 1 2>/dev/null || exit 1
        fi

        current_lang="${PLIM_LANG:-}"
        mkdir -p "$CONFIG_DIR" 2>/dev/null || true
        cat << EOF > "$CONFIG_FILE"
PLIM_API_KEY="$token"
PLIM_API_URL="${API_URL}"
EOF
        if [[ -n "$current_lang" ]]; then
            echo "PLIM_LANG=\"$current_lang\"" >> "$CONFIG_FILE"
        fi
        chmod 600 "$CONFIG_FILE" 2>/dev/null || true

        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "✅ Configuração salva em $CONFIG_FILE"
            echo "📡 Conectando ao Plim Cloud..."
        else
            echo "✅ Configuration saved to $CONFIG_FILE"
            echo "📡 Connecting to Plim Cloud..."
        fi

        res=$(curl -s -X POST "${API_URL}/api/connect" \
            -H "Content-Type: application/json" \
            -d "{\"token\": \"$token\"}")

        if echo "$res" | grep -q '"ok":true'; then
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "🎉 Conectado com sucesso! Verifique a notificação de boas-vindas no seu Telegram."
            else
                echo "🎉 Connected successfully! Check the welcome notification on your Telegram."
            fi
        else
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "⚠️  Salvo localmente, mas a verificação remota retornou: $res"
                echo "Você pode testar o envio com: plim test"
            else
                echo "⚠️  Saved locally, but remote verification returned: $res"
                echo "You can test delivery with: plim test"
            fi
        fi
        ;;

    --notification|-n)
        shift
        handle_notify_or_pipe "$@"
        ;;

    --play|-p)
        play_sound "$2"
        ;;

    --list|-l)
        if [[ "$OSTYPE" == "darwin"* && -d "$SOUNDS_DIR" ]]; then
            ls "$SOUNDS_DIR" | sed 's/\.aiff$//'
        else
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "Sons de sistema disponíveis:"
                echo "  success (som de conclusão)"
                echo "  error   (som de alerta)"
                echo "  random  (som aleatório)"
            else
                echo "Available system sounds:"
                echo "  success (completion sound)"
                echo "  error   (alert sound)"
                echo "  random  (random sound)"
            fi
        fi
        ;;

    test|--test)
        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "🔊 Testando som local..."
            play_sound "success"
            show_desktop_notification "Plim" "Teste local do Plim funcionando!"
        else
            echo "🔊 Testing local sound..."
            play_sound "success"
            show_desktop_notification "Plim" "Plim local test working!"
        fi

        if [[ -n "$PLIM_API_KEY" ]]; then
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "📱 Enviando notificação de teste via Plim Cloud (Worker)..."
                SYNC_NOTIFY=true send_remote_notification "🔔 Teste do Plim" "A integração com o Plim Cloud está 100% funcionando! 🎉" "" "" "info"
                echo "✅ Requisição enviada para a API."
            else
                echo "📱 Sending test notification via Plim Cloud (Worker)..."
                SYNC_NOTIFY=true send_remote_notification "🔔 Plim Test" "Plim Cloud integration is working 100%! 🎉" "" "" "info"
                echo "✅ Request sent to API."
            fi
        elif [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "📱 Enviando notificação de teste direto para o Telegram..."
                SYNC_NOTIFY=true send_telegram_direct "🔔 Teste do Plim" "A integração com seu bot do Telegram está funcionando! 🎉" ""
                echo "✅ Mensagem enviada para o Telegram (Chat ID: $TELEGRAM_CHAT_ID)."
            else
                echo "📱 Sending test notification directly to Telegram..."
                SYNC_NOTIFY=true send_telegram_direct "🔔 Plim Test" "Integration with your Telegram bot is working! 🎉" ""
                echo "✅ Message sent to Telegram (Chat ID: $TELEGRAM_CHAT_ID)."
            fi
        else
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "⚠️  Nenhum serviço remoto configurado."
                echo "Para conectar com 1 clique:"
                echo "  1. Abra https://t.me/plim_the_bot e envie /start"
                echo "  2. Rode: plim connect <SEU_TOKEN>"
            else
                echo "⚠️  No remote service configured."
                echo "To connect in 1 click:"
                echo "  1. Open https://t.me/plim_the_bot and send /start"
                echo "  2. Run: plim connect <YOUR_TOKEN>"
            fi
        fi
        ;;

    config|--config)
        shift
        if [[ "$1" == "set" ]]; then
            token="$2"
            chat_id="$3"
            if [[ -z "$token" || -z "$chat_id" ]]; then
                if [[ "$PLIM_LANG" == "pt" ]]; then
                    echo "Uso: plim config set <BOT_TOKEN> <CHAT_ID>"
                else
                    echo "Usage: plim config set <BOT_TOKEN> <CHAT_ID>"
                fi
                return 1 2>/dev/null || exit 1
            fi
            mkdir -p "$CONFIG_DIR" 2>/dev/null || true
            cat << EOF > "$CONFIG_FILE"
TELEGRAM_BOT_TOKEN="$token"
TELEGRAM_CHAT_ID="$chat_id"
EOF
            chmod 600 "$CONFIG_FILE" 2>/dev/null || true
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "✅ Configuração salva com sucesso em: $CONFIG_FILE"
            else
                echo "✅ Configuration successfully saved to: $CONFIG_FILE"
            fi
            return 0 2>/dev/null || exit 0
        fi

        if [[ "$1" == "set-url" ]]; then
            url="$2"
            if [[ -z "$url" ]]; then
                if [[ "$PLIM_LANG" == "pt" ]]; then
                    echo "Uso: plim config set-url <URL_DA_API>"
                else
                    echo "Usage: plim config set-url <API_URL>"
                fi
                return 1 2>/dev/null || exit 1
            fi
            mkdir -p "$CONFIG_DIR" 2>/dev/null || true
            echo "PLIM_API_URL=\"$url\"" >> "$CONFIG_FILE"
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "✅ URL da API configurada para: $url"
            else
                echo "✅ API URL configured to: $url"
            fi
            return 0 2>/dev/null || exit 0
        fi

        if [[ "$PLIM_LANG" == "pt" ]]; then
            echo "Configuração do Plim:"
            echo "Arquivo: $CONFIG_FILE"
            echo ""
            if [[ -f "$CONFIG_FILE" ]]; then
                cat "$CONFIG_FILE"
            else
                echo "Nenhum arquivo de configuração ativo."
                echo "Para conectar ao Cloudflare Worker:"
                echo "  plim connect <SEU_TOKEN>"
                echo "Ou para usar bot próprio:"
                echo '  plim config set "<BOT_TOKEN>" "<CHAT_ID>"'
            fi
        else
            echo "Plim Configuration:"
            echo "File: $CONFIG_FILE"
            echo ""
            if [[ -f "$CONFIG_FILE" ]]; then
                cat "$CONFIG_FILE"
            else
                echo "No active configuration file."
                echo "To connect to Cloudflare Worker:"
                echo "  plim connect <YOUR_TOKEN>"
                echo "Or to use a custom bot:"
                echo '  plim config set "<BOT_TOKEN>" "<CHAT_ID>"'
            fi
        fi
        ;;

    ""|--random|-r)
        if [[ ! -t 0 ]]; then
            handle_notify_or_pipe
        else
            play_sound "random"
        fi
        ;;

    *)
        # Se houver entrada vinda de pipe OU se foi passada uma mensagem avulsa (ex: plim "Deploy pronto")
        if [[ ! -t 0 ]] || [[ "$1" != -* ]]; then
            handle_notify_or_pipe "$@"
        else
            if [[ "$PLIM_LANG" == "pt" ]]; then
                echo "Uso:"
                echo "  plim                           # Toca som aleatório ou sinal sonoro"
                echo "  plim [mensagem]                # Notificação rápida (ex: plim 'Deploy pronto')"
                echo "  plim ask <pergunta> [opções]   # Pergunta interativa com botões no Telegram e aguarda resposta"
                echo "  plim run <comando e args>      # Roda o comando, mede tempo, detecta sucesso/erro e notifica"
                echo "  plim run --progress <cmds>     # Executa cadeia de comandos com Live Status no Telegram"
                echo "  plim progress run <cmds>       # Executa cadeia de comandos com Live Status no Telegram"
                echo "  plim progress start/update/... # Gerencia mensagens dinâmicas de progresso no Telegram"
                echo "  plim hook [zsh|bash|fish]      # Gera script do hook Auto-Plim para comandos demorados (> 30s)"
                echo "  plim hook install              # Instala o hook do Auto-Plim no shell atual"
                echo "  plim hook status               # Exibe status e configurações do Auto-Plim"
                echo "  plim hook test                 # Simula disparo do Auto-Plim com comando demorado"
                echo "  plim -n 'Mensagem'             # Notificação no desktop e Telegram"
                echo "  comando | plim                 # Lê a saída em tempo real e avisa no término"
                echo "  comando | plim 'Mensagem'      # Lê a saída e notifica com mensagem customizada"
                echo "  plim connect <token>           # Conecta sua conta usando token do @plim_the_bot"
                echo "  plim mcp                       # Inicia servidor MCP para agentes de IA (Claude, Cursor, etc.)"
                echo "  plim lang [en|pt]              # Exibe ou define idioma da CLI"
                echo "  plim update                    # Atualiza o Plim para a versão mais recente"
                echo "  plim version                   # Exibe a versão atual do Plim (-v)"
                echo "  plim config                    # Exibe configuração atual"
                echo "  plim -p <som>                  # Toca um som específico (success, error, Ping, etc.)"
                echo "  plim -l                        # Lista sons disponíveis"
            else
                echo "Usage:"
                echo "  plim                           # Play random sound or terminal bell"
                echo "  plim [message]                 # Quick notification (e.g. plim 'Build finished')"
                echo "  plim ask <question> [options]  # Interactive question with Telegram buttons, wait for answer"
                echo "  plim run <command and args>    # Run command, measure time, detect success/error, notify"
                echo "  plim run --progress <cmds>     # Run command chain with dynamic Live Status on Telegram"
                echo "  plim progress run <cmds>       # Run command chain with dynamic Live Status on Telegram"
                echo "  plim progress start/update/... # Manage in-place dynamic progress messages on Telegram"
                echo "  plim hook [zsh|bash|fish]      # Output Auto-Plim shell hook for long-running commands (> 30s)"
                echo "  plim hook install              # Install Auto-Plim hook into current shell profile"
                echo "  plim hook status               # View Auto-Plim status and configuration"
                echo "  plim hook test                 # Simulate Auto-Plim notification with a long command"
                echo "  plim -n 'Message'              # Desktop and Telegram push notification"
                echo "  command | plim                 # Stream output and alert when finished"
                echo "  command | plim 'Message'       # Stream output and notify with custom message"
                echo "  plim connect <token>           # Connect account with token from @plim_the_bot"
                echo "  plim mcp                       # Start MCP server for AI coding agents (Claude, Cursor, etc.)"
                echo "  plim lang [en|pt]              # Display or set CLI display language"
                echo "  plim update                    # Upgrade Plim to the latest version"
                echo "  plim version                   # Display current Plim version (-v)"
                echo "  plim config                    # View current configuration"
                echo "  plim -p <sound>                # Play specific sound (success, error, Ping, etc.)"
                echo "  plim -l                        # List available sounds"
            fi
        fi
        ;;
esac
