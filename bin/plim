#!/bin/zsh

# Carrega configurações (~/.config/plim/config ou ~/.plimrc)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/plim"
CONFIG_FILE="$CONFIG_DIR/config"
[[ -f "$HOME/.plimrc" ]] && CONFIG_FILE="$HOME/.plimrc"
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

SOUNDS_DIR="/System/Library/Sounds"

random_sound() {
    local sounds=($SOUNDS_DIR/*.aiff)
    echo "${sounds[$((RANDOM % ${#sounds[@]} + 1))]}"
}

send_telegram() {
    local title="$1"
    local body="$2"
    local extra="$3"

    if [[ -z "$TELEGRAM_BOT_TOKEN" || -z "$TELEGRAM_CHAT_ID" ]]; then
        return 0
    fi

    local nl=$'\n'
    local text="<b>${title}</b>"
    if [[ -n "$body" ]]; then
        text="${text}${nl}${body}"
    fi

    if [[ -n "$extra" ]]; then
        local escaped_extra=$(echo "$extra" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')
        if [[ ${#escaped_extra} -gt 3500 ]]; then
            escaped_extra="${escaped_extra[-3500,-1]}"
        fi
        text="${text}${nl}${nl}<pre>${escaped_extra}</pre>"
    fi

    curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
        -d chat_id="${TELEGRAM_CHAT_ID}" \
        --data-urlencode "text=${text}" \
        -d parse_mode="HTML" >/dev/null 2>&1 &
}

format_duration() {
    local elapsed=$1
    if [[ $elapsed -ge 3600 ]]; then
        echo "$((elapsed / 3600))h $(((elapsed % 3600) / 60))m $((elapsed % 60))s"
    elif [[ $elapsed -ge 60 ]]; then
        echo "$((elapsed / 60))m $((elapsed % 60))s"
    else
        echo "${elapsed}s"
    fi
}

run_command() {
    if [[ $# -eq 0 ]]; then
        echo "Uso: plim run <comando e argumentos>"
        echo "Exemplo: plim run npm run build"
        return 1
    fi

    local full_cmd="$*"
    local start_time=$(date +%s)
    local temp_out=$(mktemp -t plim_output.XXXXXX)

    echo "🚀 [plim] Executando: $full_cmd"

    # Executa o comando via eval para suportar flags, pipes e cadeias
    eval "$@" 2>&1 | tee "$temp_out"
    local exit_code=${pipestatus[1]:-${PIPESTATUS[0]:-$?}}

    local end_time=$(date +%s)
    local duration=$(format_duration $((end_time - start_time)))

    local tail_output=$(tail -n 15 "$temp_out")
    rm -f "$temp_out"

    local status_icon status_label sound_name
    if [[ $exit_code -eq 0 ]]; then
        status_icon="✅"
        status_label="Sucesso"
        sound_name="Ping"
    else
        status_icon="❌"
        status_label="Falha (exit $exit_code)"
        sound_name="Basso"
    fi

    # Som
    if [[ -f "$SOUNDS_DIR/${sound_name}.aiff" ]]; then
        afplay "$SOUNDS_DIR/${sound_name}.aiff" &
    else
        afplay "$(random_sound)" &
    fi

    # Notificação local macOS
    local nl=$'\n'
    osascript -e "display notification \"Duração: ${duration}${nl}${full_cmd}\" with title \"${status_icon} Plim: ${status_label}\"" 2>/dev/null &

    # Notificação Telegram
    send_telegram "${status_icon} ${status_label}: <code>${full_cmd}</code>" "⏱ <b>Duração:</b> ${duration}" "$tail_output"

    return $exit_code
}

case "$1" in
    run|--run)
        shift
        run_command "$@"
        ;;

    --notification|-n)
        shift
        local message="$*"
        local input_data=""

        # Se houver entrada vinda de pipe (ex: comando | plim -n "Fim")
        if [[ ! -t 0 ]]; then
            input_data=$(cat)
            echo "$input_data"
        fi

        sound=$(random_sound)
        afplay "$sound" &

        # Interpreta \n se passado na mensagem
        [[ -n "$message" ]] && message=$(printf "%b" "$message")

        local mac_msg="${message:-Notificação recebida}"
        if [[ -z "$message" && -n "$input_data" ]]; then
            mac_msg=$(echo "$input_data" | tail -n 2)
        fi
        osascript -e "display notification \"$mac_msg\" with title \"Plim\"" 2>/dev/null &

        if [[ -n "$message" ]]; then
            send_telegram "🔔 Plim" "$message" "$input_data"
        else
            send_telegram "🔔 Plim" "" "$input_data"
        fi
        ;;

    --play|-p)
        afplay "$SOUNDS_DIR/$2.aiff"
        ;;

    --list|-l)
        ls "$SOUNDS_DIR" | sed 's/\.aiff$//'
        ;;

    test|--test)
        echo "🔊 Testando som local..."
        afplay "$(random_sound)" &
        osascript -e "display notification \"Teste local do Plim funcionando!\" with title \"Plim\"" 2>/dev/null &

        if [[ -n "$TELEGRAM_BOT_TOKEN" && -n "$TELEGRAM_CHAT_ID" ]]; then
            echo "📱 Enviando notificação de teste para o Telegram..."
            send_telegram "🔔 Teste do Plim" "Se você recebeu esta mensagem, a integração com o Telegram está 100% funcionando! 🎉" ""
            echo "✅ Mensagem enviada para o Telegram (Chat ID: $TELEGRAM_CHAT_ID)."
        else
            echo "⚠️  Telegram não configurado."
            echo "Crie o arquivo $CONFIG_FILE com:"
            echo '  TELEGRAM_BOT_TOKEN="seu_token"'
            echo '  TELEGRAM_CHAT_ID="seu_chat_id"'
        fi
        ;;

    config|--config)
        shift
        if [[ "$1" == "set" ]]; then
            local token="$2"
            local chat_id="$3"
            if [[ -z "$token" || -z "$chat_id" ]]; then
                echo "Uso: plim config set <BOT_TOKEN> <CHAT_ID>"
                return 1
            fi
            mkdir -p "$CONFIG_DIR" 2>/dev/null || true
            cat << EOF > "$CONFIG_FILE"
TELEGRAM_BOT_TOKEN="$token"
TELEGRAM_CHAT_ID="$chat_id"
EOF
            chmod 600 "$CONFIG_FILE" 2>/dev/null || true
            echo "✅ Configuração salva com sucesso em: $CONFIG_FILE"
            return 0
        fi

        echo "Configuração do Plim:"
        echo "Arquivo: $CONFIG_FILE"
        echo ""
        if [[ -f "$CONFIG_FILE" ]]; then
            cat "$CONFIG_FILE"
        else
            echo "Arquivo ainda não configurado."
            echo "Para configurar rapidamente, execute:"
            echo '  plim config set "<SEU_BOT_TOKEN>" "<SEU_CHAT_ID>"'
        fi
        ;;

    ""|--random|-r)
        sound=$(random_sound)
        afplay "$sound"
        ;;

    *)
        echo "Uso:"
        echo "  plim                           # Toca som aleatório"
        echo "  plim -n 'Mensagem'             # Notificação no Mac e Telegram"
        echo "  comando | plim -n 'Deploy'     # Lê a saída do comando e notifica"
        echo "  plim run <comando e args>      # Roda o comando, mede tempo, detecta sucesso/erro e envia output"
        echo "  plim -p Ping                   # Toca um som específico"
        echo "  plim -l                        # Lista sons disponíveis"
        echo "  plim test                      # Testa som e envio ao Telegram"
        echo "  plim config                    # Mostra configuração do Telegram"
        ;;
esac

